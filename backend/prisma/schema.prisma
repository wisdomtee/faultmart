generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////
// ENUMS
//////////////////////////////

enum Role {
  SUPER_ADMIN
  ADMIN
  SELLER
  BUYER
}

enum ListingStatus {
  DRAFT
  PENDING
  ACTIVE
  SOLD
  REJECTED
  ARCHIVED
}

enum ConditionType {
  FAULTY
  REPAIRABLE
  FOR_PARTS
  REFURBISHED
}

//////////////////////////////
// USER
//////////////////////////////

model User {
  id              String    @id @default(cuid())

  firstName       String
  lastName        String

  email           String    @unique
  phone           String?   @unique

  password        String

  role            Role      @default(BUYER)

  avatar          String?

  isVerified      Boolean   @default(false)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  listings        Listing[]

  favorites       Favorite[]

  @@index([email])
  @@index([role])
}

//////////////////////////////
// CATEGORY
//////////////////////////////

model Category {

  id          String      @id @default(cuid())

  name        String      @unique

  slug        String      @unique

  icon        String?

  createdAt   DateTime    @default(now())

  updatedAt   DateTime    @updatedAt

  deletedAt   DateTime?

  listings    Listing[]

}

//////////////////////////////
// LISTING
//////////////////////////////

model Listing {

  id                  String          @id @default(cuid())

  title               String

  slug                String          @unique

  description         String

  faultDescription    String

  price               Decimal         @db.Decimal(12,2)

  isNegotiable        Boolean         @default(false)

  state               String

  city                String

  address             String?

  conditionType       ConditionType

  status              ListingStatus   @default(PENDING)

  views               Int             @default(0)

  createdAt           DateTime        @default(now())

  updatedAt           DateTime        @updatedAt

  deletedAt           DateTime?

  sellerId            String

  categoryId          String

  seller              User            @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  category            Category        @relation(fields: [categoryId], references: [id])

  images              ListingImage[]

  videos              ListingVideo[]

  favorites           Favorite[]

  @@index([sellerId])

  @@index([categoryId])

  @@index([status])

  @@index([createdAt])

}

//////////////////////////////
// LISTING IMAGES
//////////////////////////////

model ListingImage {

  id          String      @id @default(cuid())

  url         String

  createdAt   DateTime    @default(now())

  listingId   String

  listing     Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])

}

//////////////////////////////
// LISTING VIDEOS
//////////////////////////////

model ListingVideo {

  id          String      @id @default(cuid())

  url         String

  createdAt   DateTime    @default(now())

  listingId   String

  listing     Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])

}